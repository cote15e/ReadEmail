# ========================
# Источник данных (выберите один)
# ========================

# --- Gmail (дайджест Medium) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Тема письма-дайджеста (подстрока, без учёта регистра).
# Несколько вариантов через запятую, например:
# EMAIL_DIGEST_SUBJECT=Medium Weekly Digest,Medium Daily Digest
EMAIL_DIGEST_SUBJECT=Medium Weekly Digest

# --- Google Drive (PDF-файлы статей) ---
# Раскомментируйте, если источник — PDF на Google Диске
# GDRIVE_FOLDER_NAME=MediumArticlesPdf

# ========================
# Google API (Drive, Sheets)
# ========================
GOOGLE_DRIVE_CREDENTIALS_FILE=/app/secrets/credentials.json
GOOGLE_DRIVE_TOKEN_FILE=/app/secrets/token.json
GOOGLE_SHEETS_TOKEN_FILE=/app/secrets/token_sheets.json

# Google Sheets — таблица для результатов
G_SHEETS_SPREADSHEET_NAME=Medium_Digest
G_SHEETS_SPREADSHEET_ID=

# ========================
# AI (аннотации статей)
# ========================
# Провайдер: openai | openrouter | routerai
AI_PROVIDER=openai
SEND_TO_GPT=true

# Модель (зависит от провайдера):
#   openai:     gpt-4o
#   openrouter: openai/gpt-4o
#   routerai:   openai/gpt-4o
AI_MODEL=gpt-4o
# OPENAI_MODEL=gpt-4o   # устаревший алиас AI_MODEL

# Ключи — достаточно одного для выбранного провайдера.
# AI_API_KEY можно использовать как общий fallback.
# AI_API_KEY=
OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ROUTERAI_API_KEY=sk-...

# Опционально: свой endpoint (перекрывает URL провайдера)
# AI_BASE_URL=https://openrouter.ai/api/v1

# ========================
# Playwright
# ========================
PLAYWRIGHT_HEADLESS=true

# ========================
# Отладка
# ========================
DEBUG=false

# ========================
# Cron (только для режима cron)
# ========================
# CRON_SCHEDULE=0 8 * * *
